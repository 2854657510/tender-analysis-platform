# 环境变量模板。复制成 .env 后填入真实值：cp .env.example .env
#
# ⚠️ .env 里有真实密钥，永远不进 git（见 .gitignore）。
#    这个 .env.example 是给"别人 clone 你的项目后知道要配什么"用的。

DEEPSEEK_API_KEY=sk-在这里填你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- 以下都有默认值，不填也能跑，需要时再改 ----
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# RECALL_TOP_K=20
# RERANK_TOP_K=5
# MAX_AGENT_STEPS=10
